# vorpal keys. Copy to .env and fill in:
#
#     cp .env.example .env && chmod 600 .env
#
# .env is gitignored and is never committed. This template is committed and
# must never hold a real key.
#
# Every run loads .env and prints the key NAMES it read, never the values.
# A key already exported in your shell beats this file, so a one-off
# `ANTHROPIC_API_KEY=other uv run vorpal ...` still overrides for that run.
#
# The path is relative to where you run the command. Run from the repo root,
# or pass --env /path/to/.env.

# Required. The model recommendation. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required. Stats, ADP, ECR, and bye weeks.
# Pass --override <csv> instead when FantasyPros is down.
FANTASYPROS_API_KEY=

# Optional. Only read when you pass --trace, and only with the tracing extra
# installed (`uv sync --extra tracing`). Without it the run warns once and
# continues untraced, so it never blocks a draft.
LANGSMITH_API_KEY=

# Optional. A label for the traced runs. Any string.
LANGSMITH_PROJECT=vorpal-draft-night

# GitHub needs no key here. The draft-complete issue shells out to `gh`,
# which uses your existing `gh auth login`.
